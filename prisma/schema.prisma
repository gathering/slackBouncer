generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  auditLogs AdminAuditLog[]

  @@map("admins")
}

model SlackUser {
  id          String   @id
  name        String
  realName    String   @map("real_name")
  displayName String   @map("display_name")
  email       String?
  isBot              Boolean  @default(false) @map("is_bot")
  isDeleted          Boolean  @default(false) @map("is_deleted")
  isRestricted       Boolean  @default(false) @map("is_restricted")
  isUltraRestricted  Boolean  @default(false) @map("is_ultra_restricted")
  syncedAt           DateTime @default(now()) @map("synced_at")

  usageEvents          UsageEvent[]
  channelAllowedUsers  ChannelAllowedUser[]
  globalAllowedUsers   GlobalAllowedUser[]

  @@map("slack_users")
}

model SlackChannel {
  id          String   @id
  name        String
  isGeneral   Boolean  @default(false) @map("is_general")
  isPrivate   Boolean  @default(false) @map("is_private")
  isArchived  Boolean  @default(false) @map("is_archived")
  syncedAt    DateTime @default(now()) @map("synced_at")

  settings    ChannelSettings?
  usageEvents UsageEvent[]

  @@map("slack_channels")
}

model ChannelSettings {
  id            String   @id @default(uuid())
  channelId     String   @unique @map("channel_id")
  isEnabled     Boolean  @default(false) @map("is_enabled")
  allowAllUsers Boolean  @default(false) @map("allow_all_users")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  channel      SlackChannel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  allowedUsers ChannelAllowedUser[]

  @@map("channel_settings")
}

model ChannelAllowedUser {
  id               String   @id @default(uuid())
  channelSettingId String   @map("channel_setting_id")
  userId           String   @map("user_id")
  createdAt        DateTime @default(now()) @map("created_at")

  channelSetting ChannelSettings @relation(fields: [channelSettingId], references: [id], onDelete: Cascade)
  user           SlackUser       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelSettingId, userId])
  @@map("channel_allowed_users")
}

model GlobalAllowedUser {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  user SlackUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("global_allowed_users")
}

model UsageEvent {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  channelId String   @map("channel_id")
  hadText   Boolean  @default(false) @map("had_text")
  createdAt DateTime @default(now()) @map("created_at")

  user    SlackUser    @relation(fields: [userId], references: [id])
  channel SlackChannel @relation(fields: [channelId], references: [id])

  @@map("usage_events")
}

model AdminAuditLog {
  id        String   @id @default(uuid())
  adminId   String   @map("admin_id")
  action    String
  entity    String
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  admin Admin @relation(fields: [adminId], references: [id])

  @@map("admin_audit_log")
}
